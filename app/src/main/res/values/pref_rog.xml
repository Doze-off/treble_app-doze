<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Evenly split across the confirmed valid 0-255 setpoint range -
    rog5_inbox.c's fan_rpm_store() rejects anything outside it. These
    are not named/documented ASUS presets, just round numbers within
    the range that's actually confirmed to work. -->
    <array name="pref_rog_fan">
        <item>Off</item>
        <item>Low</item>
        <item>Medium</item>
        <item>High</item>
        <item>Max</item>
    </array>
    <array name="pref_rog_fan_values">
        <item>"0"</item>
        <item>"64"</item>
        <item>"128"</item>
        <item>"192"</item>
        <item>"255"</item>
    </array>

    <!-- The three values rise_report_rate_store actually recognizes -
         anything else is silently ignored by the touch IC driver. -->
    <array name="pref_rog_report_rate">
        <item>Auto (120/300Hz)</item>
        <item>Force 300Hz</item>
        <item>Force 560Hz</item>
    </array>
    <array name="pref_rog_report_rate_values">
        <item>"0"</item>
        <item>"1"</item>
        <item>"2"</item>
    </array>

    <!-- edge_settings' Rcoefleft/Rcoefright, kernel-validated 0-10; 11 lands
         past the driver's own ">10 disables it" threshold on purpose. -->
    <array name="pref_rog_edge_reject">
        <item>Off</item>
        <item>1 (lightest)</item>
        <item>3</item>
        <item>5</item>
        <item>7</item>
        <item>10 (strongest)</item>
    </array>
    <array name="pref_rog_edge_reject_values">
        <item>"11"</item>
        <item>"1"</item>
        <item>"3"</item>
        <item>"5"</item>
        <item>"7"</item>
        <item>"10"</item>
    </array>

    <!-- persist.sys.charginglimit's own recognized values, from ASUS's
         init.asus.rc "Rev 2.0 of slow charging" block. The numeric codes
         are what init.asus.rc actually matches on - they don't map 1:1 to
         a charge percentage but are labeled here by their code value so
         the user can cross-reference with ASUS documentation or trial
         and error. 0 = off. -->
    <array name="pref_rog_charging_limit">
        <item>Off</item>
        <item>Level 9</item>
        <item>Level 10</item>
        <item>Level 12</item>
        <item>Level 15</item>
        <item>Level 18</item>
        <item>Level 30</item>
        <item>Level 45</item>
        <item>Level 65</item>
    </array>
    <array name="pref_rog_charging_limit_values">
        <item>"0"</item>
        <item>"9"</item>
        <item>"10"</item>
        <item>"12"</item>
        <item>"15"</item>
        <item>"18"</item>
        <item>"30"</item>
        <item>"45"</item>
        <item>"65"</item>
    </array>

    <!-- Multi-STA concurrency modes (Qualcomm FastConnect 6900 / WCN6850):
         0: Disabled (Single STA)
         1: Dual-band simultaneous (2.4GHz + 5GHz same AP)
         2: Multi-AP (Concurrent connection to two distinct APs) -->
    <array name="pref_rog_dual_wifi">
        <item>Off</item>
        <item>Same network, dual-band (2.4 GHz + 5 GHz)</item>
        <item>Two networks simultaneously</item>
    </array>
    <array name="pref_rog_dual_wifi_values">
        <item>"0"</item>
        <item>"1"</item>
        <item>"2"</item>
    </array>
</resources>
