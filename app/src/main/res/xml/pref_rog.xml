<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        android:title="Aura Sync RGB"
        android:layout="@layout/preference_category_custom">
        <SwitchPreference
            android:layout="@layout/preference_switch_custom"
            android:defaultValue="false"
            android:key="rog_aura_enable"
            android:title="Enable Aura Sync RGB" />
        <EditTextPreference
            android:layout="@layout/preference_edittext_custom"
            android:defaultValue="0"
            android:inputType="number"
            android:key="rog_aura_mode"
            android:summary="Raw mode index sent to the MCU (0 and up) - named effect mappings aren't documented in ASUS's published source, so this is trial and error"
            android:title="Aura Sync mode" />
        <EditTextPreference
            android:layout="@layout/preference_edittext_custom"
            android:defaultValue="255"
            android:inputType="number"
            android:key="rog_aura_red"
            android:title="Red (0-255)" />
        <EditTextPreference
            android:layout="@layout/preference_edittext_custom"
            android:defaultValue="255"
            android:inputType="number"
            android:key="rog_aura_green"
            android:title="Green (0-255)" />
        <EditTextPreference
            android:layout="@layout/preference_edittext_custom"
            android:defaultValue="255"
            android:inputType="number"
            android:key="rog_aura_blue"
            android:title="Blue (0-255)" />
    </PreferenceCategory>
    <PreferenceCategory
        android:title="AeroActive Cooler 5"
        android:layout="@layout/preference_category_custom">
        <SwitchPreference
            android:layout="@layout/preference_switch_custom"
            android:defaultValue="false"
            android:key="rog_cooler_fan_enable"
            android:title="Enable cooler fan" />
        <ListPreference
            android:layout="@layout/preference_list_custom"
            android:defaultValue="0"
            android:entries="@array/pref_rog_fan"
            android:entryValues="@array/pref_rog_fan_values"
            android:key="rog_cooler_fan_speed"
            android:summary="Only takes effect while the AeroActive Cooler 5 is attached"
            android:title="Cooler fan speed" />
    </PreferenceCategory>
    <PreferenceCategory android:title="X Mode gaming touch">
        <SwitchPreference
            android:defaultValue="false"
            android:key="rog_game_mode"
            android:title="Game mode"
            android:summary="Puts the touch IC into its game-tuned scan mode" />
        <ListPreference
            android:defaultValue="0"
            android:entries="@array/pref_rog_report_rate"
            android:entryValues="@array/pref_rog_report_rate_values"
            android:key="rog_touch_report_rate"
            android:title="Touch report rate" />
        <ListPreference
            android:defaultValue="11"
            android:entries="@array/pref_rog_edge_reject"
            android:entryValues="@array/pref_rog_edge_reject_values"
            android:key="rog_edge_reject_strength"
            android:summary="Rejects touches near the edges while gripping the phone in landscape"
            android:title="Corner-grip rejection" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Charging">
        <ListPreference
            android:defaultValue="0"
            android:entries="@array/pref_rog_charging_limit"
            android:entryValues="@array/pref_rog_charging_limit_values"
            android:key="rog_charging_limit"
            android:summary="Exact percentage/behavior per level isn't documented by ASUS - trial and error"
            android:title="Charging limit" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="rog_ultra_battery_life"
            android:title="Ultra battery life" />
    </PreferenceCategory>
</PreferenceScreen>
