<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        android:title="Aura Sync RGB"
        android:layout="@layout/preference_category_custom">
        <!--
             Was 1 SwitchPreference + 1 EditTextPreference for mode + 3
             EditTextPreferences for R/G/B (typing 0-255 into a text box per
             channel). Replaced with a single entry point into
             AuraSyncActivity: live color wheel-style sliders, a preview
             swatch, one-tap presets, and a mode stepper - see that
             activity's own header comment for why mode has no named
             presets yet.
        -->
        <Preference
            android:layout="@layout/preference_edittext_custom"
            android:key="rog_aura_sync_open"
            android:title="Aura Sync RGB"
            android:summary="Color, brightness and mode - opens a dedicated screen" />
        <Preference
            android:layout="@layout/preference_edittext_custom"
            android:key="rog_aura_lighting_triggers_open"
            android:title="Lighting triggers"
            android:summary="React to calls, charging, notifications and music - opens a dedicated screen" />
    </PreferenceCategory>
    <PreferenceCategory
        android:title="AeroActive Cooler 5"
        android:layout="@layout/preference_category_custom">
        <SwitchPreference
            android:layout="@layout/preference_switch_custom"
            android:defaultValue="false"
            android:key="rog_cooler_fan_enable"
            android:title="Enable cooler fan" />
        <ListPreference
            android:layout="@layout/preference_list_custom"
            android:defaultValue="0"
            android:entries="@array/pref_rog_fan"
            android:entryValues="@array/pref_rog_fan_values"
            android:key="rog_cooler_fan_speed"
            android:summary="Only takes effect while the AeroActive Cooler 5 is attached"
            android:title="Cooler fan speed" />
    </PreferenceCategory>
    <PreferenceCategory
        android:title="X Mode gaming touch"
        android:layout="@layout/preference_category_custom">
        <SwitchPreference
            android:layout="@layout/preference_switch_custom"
            android:defaultValue="false"
            android:key="rog_game_mode"
            android:title="Game mode"
            android:summary="High-rate touch scan mode and CPU scheduler boost for gaming" />
        <ListPreference
            android:layout="@layout/preference_list_custom"
            android:defaultValue="0"
            android:entries="@array/pref_rog_report_rate"
            android:entryValues="@array/pref_rog_report_rate_values"
            android:key="rog_touch_report_rate"
            android:summary="Higher rates reduce input latency at the cost of slightly more battery"
            android:title="Touch report rate" />
        <!--
             Was a ListPreference (android.preference, same as touch report
             rate above) - reproducibly crashed the app with a
             NullPointerException in ArrayAdapter.createViewFromResource
             every time this specific dialog opened (3/3 repro), even
             though its entries/entryValues arrays are well-formed and the
             sibling ListPreference above works fine. Root cause wasn't
             pinned down with certainty without a debugger attached, so
             instead of guessing at the resource-array codepath, this is
             now a plain Preference whose click listener
             (RogSettingsFragment.kt) builds the AlertDialog manually from
             a hardcoded, guaranteed-non-null Kotlin array - sidesteps
             whatever the resource-resolution issue was rather than
             patching around it blind.
        -->
        <Preference
            android:layout="@layout/preference_edittext_custom"
            android:key="rog_edge_reject_strength"
            android:title="Corner-grip rejection"
            android:summary="Suppress accidental edge touches while gripping the phone in landscape" />
    </PreferenceCategory>
    <PreferenceCategory
        android:title="Charging"
        android:layout="@layout/preference_category_custom">
        <ListPreference
            android:layout="@layout/preference_list_custom"
            android:defaultValue="0"
            android:entries="@array/pref_rog_charging_limit"
            android:entryValues="@array/pref_rog_charging_limit_values"
            android:key="rog_charging_limit"
            android:summary="Cap charge current to extend long-term battery health"
            android:title="Charging limit" />
        <SwitchPreference
            android:layout="@layout/preference_switch_custom"
            android:defaultValue="false"
            android:key="rog_ultra_battery_life"
            android:title="Ultra battery life"
            android:summary="Limits charging to ~60% for maximum long-term cell longevity" />
        <SwitchPreference
            android:layout="@layout/preference_switch_custom"
            android:defaultValue="false"
            android:key="rog_bypass_charging"
            android:title="Bypass charging"
            android:summary="Powers the board directly from the adapter while gaming, leaving the battery at rest to reduce heat" />
    </PreferenceCategory>
    <PreferenceCategory
        android:title="Dual Wi-Fi &amp; Network Acceleration"
        android:layout="@layout/preference_category_custom">
        <ListPreference
            android:layout="@layout/preference_list_custom"
            android:defaultValue="0"
            android:entries="@array/pref_rog_dual_wifi"
            android:entryValues="@array/pref_rog_dual_wifi_values"
            android:key="rog_dual_wifi_mode"
            android:summary="Use both Wi-Fi interfaces simultaneously for lower latency"
            android:title="Dual Wi-Fi mode" />
        <SwitchPreference
            android:layout="@layout/preference_switch_custom"
            android:defaultValue="false"
            android:key="rog_hyperfusion"
            android:title="HyperFusion"
            android:summary="Bonds Wi-Fi and mobile data to minimise gaming latency (Qualcomm SLA)" />
    </PreferenceCategory>
</PreferenceScreen>
